# ============================================================
# Kubernetes / AWS Local Files
# ============================================================
#
# These are local/generated files containing AWS configuration,
# credentials, secret values, or temporary command output.
#
# IMPORTANT:
# Do NOT ignore k8-manifests/
# Your Kubernetes manifests must be committed for CI/CD.
#

# AWS ACM validation output
acm-validation.json

# EKS / IAM policy JSON files
eks-describe-cluster-policy.json
eso-secrets-policy.json
eso-secrets-policy-prod.json

# GitHub OIDC trust policies
github-oidc-trust.json
github-actions-trust-policy-prod.json

# IAM policy / trust policy files
iam_policy.json
eso-prod-trust-policy.json

# MySQL secret files
mysql-secret.json
prod-mysql-secret.json

# Route53 temporary change files
prod-route53-change.json

# Local Kubernetes manifests / YAML files
#
# Only ignore the old/local mysql directory if it is being used
# for temporary manifests. Do NOT ignore k8-manifests/.
#
mysql/*.yaml
mysql/*.yml
mysql/*.json

